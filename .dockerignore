# Every pattern is anchored at the build context (repository root); `**/` makes
# it apply in sub-directories too. Images install their own dependencies and
# build their own output — nothing from the host checkout may leak in.

# Dependencies (pnpm symlinks from the host would break inside the image)
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
**/.next
**/.nuxt
**/.output
**/.turbo
**/dist
**/build
**/out

# Secrets and local environment — never baked into an image
**/.env
**/.env.*
!**/.env.example
deploy/ecs/secrets/
**/*.pem
**/*.key

# Local data
data/
**/*.sqlite
**/*.sqlite-journal
backups/

# IDE / OS
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Documentation, inbox, tests (not needed by any image)
README.md
*.md
docs/
inbox/
test/
tests/
e2e/
__tests__/
coverage/
test-results/
playwright-report/

# Apps no image builds
apps/next-app/
apps/tanstack-app/
apps/docs-app/
apps/nuxt-app/

# Logs / runtime data
logs
**/*.log
pids
*.pid
*.seed
*.pid.lock
tmp/
temp/
