# syntax=docker/dockerfile:1.7
# kcs/tools — the one-off `init` job and the backup / restore-drill loop.
# Postgres client tools come from the base image; keep PG_MAJOR ≥ the server's
# major version (pg_dump refuses newer servers), e.g. --build-arg PG_MAJOR=17 for RDS 17.
ARG PG_MAJOR=16

FROM node:22-bookworm-slim AS node

FROM node AS deps
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/kcs-contract/package.json packages/kcs-contract/
COPY apps/api/package.json apps/api/
# Root (TinyShip auth + drizzle-kit + tsx + AWS SDK) and the API's migrations.
# better-sqlite3's native binding is never loaded with DB_DIALECT=pg.
RUN --mount=type=cache,id=kcs-pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts --filter . --filter "@kcs/api..."

FROM postgres:${PG_MAJOR}-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /repo
COPY --from=deps /repo ./
COPY tsconfig.json config.ts ./
COPY config ./config
COPY libs ./libs
COPY packages/kcs-contract ./packages/kcs-contract
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig.json ./apps/api/
COPY deploy/tools ./deploy/tools
ENV NODE_ENV=production DB_DIALECT=pg
# Owned by the image's postgres user so a fresh named volume inherits it.
RUN mkdir -p /var/backups/kcs && chown postgres:postgres /var/backups/kcs \
  && chmod +x deploy/tools/entrypoint.sh
USER postgres
ENTRYPOINT ["/repo/deploy/tools/entrypoint.sh"]
CMD ["init"]
