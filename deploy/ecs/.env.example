# 全球达人情报系统 — 生产环境变量（单台 ECS + docker compose）
#
#   cp .env.example .env && chmod 600 .env
#
# 【必填】不填 compose 直接报错；【选填】留空即关闭 / 用默认值。
# 密钥生成：openssl rand -hex 32（只含 0-9a-f，放进连接串也不用转义）。
# 这个文件只放在服务器上，不要提交、不要发到聊天工具里。

# ─── 部署形态 ───────────────────────────────────────────────────────────────
# caddy = Caddy 自动 HTTPS（默认）；nginx = 用阿里云 SSL 证书（二选一）
# localdb = 本机 compose 里跑 Postgres 16；用 RDS 时删掉 localdb
# split-worker = 抓取单独一个进程（同时设 API_INGEST_WORKER=0，见 compose.prod.yml）
COMPOSE_PROFILES=caddy,localdb

# 镜像来源：本机 build 就保持 kcs；推到阿里云容器镜像服务（ACR）时写完整前缀，
# 如 registry.cn-hongkong.aliyuncs.com/<命名空间>
KCS_REGISTRY=kcs
# 【必填】版本号：升级 / 回滚就是改这里再 up -d（也作为 /api/health 的 version）
KCS_TAG=latest

# ─── 域名 ───────────────────────────────────────────────────────────────────
# 【必填】五个主机名，DNS A 记录都指向本机公网 IP。示例用 example.com 占位。
# 宣传站可以写两个（空格分隔），如 "example.com www.example.com"，但下面拼 URL 用第一个，
# 所以更简单的做法是宣传站用 www，裸域在 DNS 服务商那里 301 到 www。
MARKETING_HOST=www.example.com
SELECT_HOST=select.example.com
OPS_HOST=ops.example.com
DEV_HOST=dev.example.com
API_HOST=api.example.com
# 【必填】五个主机共同的父域，前面带点。会话 cookie 写在这里，跨子域登录交接靠它。
AUTH_COOKIE_DOMAIN=.example.com
# 【选填】额外允许调用登录接口的源站（逗号分隔）；四端地址已自动包含
AUTH_TRUSTED_ORIGINS=
# 只在本机验证用：对外端口不是 443 时写 ":8443"，生产留空
PUBLIC_PORT_SUFFIX=
HTTP_PORT=80
HTTPS_PORT=443

# ─── HTTPS ──────────────────────────────────────────────────────────────────
# 【Caddy 必填】证书到期提醒邮箱
ACME_EMAIL=ops@example.com
# 【选填】Caddy 全局选项。本机验证写 local_certs（Caddy 内部 CA）；生产留空
CADDY_EXTRA_GLOBAL=
# 【选填】HSTS。确认所有子域都走 https 后可改成 "max-age=31536000; includeSubDomains"
HSTS_VALUE=max-age=31536000
# 【nginx 必填】证书目录：每个主机一对 <主机名>.pem / <主机名>.key（阿里云 SSL「Nginx」格式）
NGINX_CERT_DIR=./certs

# ─── 密钥 ───────────────────────────────────────────────────────────────────
# 【必填】四端共用的 better-auth 密钥（≥ 32 字符）。改了所有人要重新登录。
BETTER_AUTH_SECRET=
# 【必填】选人池翻页游标签名。单独设，别和 BETTER_AUTH_SECRET 共用。
KCS_CURSOR_SECRET=

# ─── 首个平台管理员（init 只在这个邮箱还不存在时创建；之后在运维端「账号」页开其他人）───
# 【首次部署必填】
KCS_ADMIN_EMAIL=admin@example.com
# 【首次部署必填】≥ 12 位，不能是演示密码；登录后立刻去改，然后可以从 .env 删掉
KCS_ADMIN_PASSWORD=
KCS_ADMIN_NAME=平台管理员

# ─── 数据库 ─────────────────────────────────────────────────────────────────
# 自建（localdb）：【必填】POSTGRES_PASSWORD，下面两个 URL 留空即指向 compose 里的 postgres
POSTGRES_PASSWORD=
# RDS：【必填】两个库的连接串（在 RDS 控制台先建库 kcs、tinyship 与账号），用同 VPC 的内网地址，
# 例 postgres://kcs:<密码>@pgm-xxxx.pg.rds.aliyuncs.com:5432/kcs
# 密码里有 @ : / ? # 等字符要做 URL 编码。
# RDS 开了 SSL 时：把 RDS 控制台下载的 CA 放到服务器上，PG_CA_FILE 写它的路径，两个连接串末尾加
#   ?sslmode=verify-full&sslrootcert=/etc/kcs/pg-ca.pem
# 不要写 sslmode=require：Node 的 pg 驱动把它当 verify-full 且不认 RDS 的 CA，会连不上。
KCS_DATABASE_URL=
IDENTITY_DATABASE_URL=
PG_CA_FILE=
# 自建 Postgres 调参（按 ECS 内存改；默认按 8 GiB 机器）
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=100
PG_LOG_MIN_DURATION_MS=1000

# ─── 时区 ───────────────────────────────────────────────────────────────────
# 容器时区（日志时间）与每日任务（刷新、分层、余额查询）的日历日
TZ=Asia/Shanghai
DAILY_TASKS_TZ=Asia/Shanghai
DAILY_TASKS_HOUR=4

# ─── 采集供应商（都可以先不填：不填时全部数据源是 fixture 演示模式）──────────────
# 【选填】蒲公英经 TikHub。香港 / 海外地域用 https://api.tikhub.io；
# ECS 在中国大陆时改成 https://api.tikhub.dev
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
# 余额低于多少美元时运维端首页提醒
TIKHUB_BALANCE_ALERT_USD=5
PGY_GATEWAY=tikhub
PGY_ACCESS_TOKEN=
PGY_BASE_URL=
PGY_BRAND_USER_ID=
PGY_ENRICH=0
PGY_TIMEOUT_MS=60000
PGY_SLOW_REFRESH_DAYS=30
PGY_TRAFFIC_SCOPE=
PGY_BUSINESS_SCOPE=
# 预算（美元 / 天）。第一次接真实 key 建议先设 1；none = 不限，只看次数
PGY_DAILY_BUDGET_USD=1
QIANGUA_TOKEN=
QIANGUA_BASE_URL=https://api.qian-gua.com
QIANGUA_DAILY_BUDGET_USD=
XINHONG_TOKEN=
XINHONG_BASE_URL=https://api.newrank.cn
XINHONG_DAILY_BUDGET_USD=
# 单价覆盖 JSON，如 {"tikhub:/api/v1/xiaohongshu/pgy/": 0.02}
KCS_VENDOR_PRICES=
# 1 = 调度器按预算自动排刷新任务；0 = 只跑人工发起的
INGEST_SCHEDULER=0
# 1 = web 进程顺带抽水（默认）；拆分时设 0 并启用 split-worker
API_INGEST_WORKER=1

# ─── 数据保留（现阶段全部保留，0 = 不删）───────────────────────────────────────
RETENTION_RAW_PER_SOURCE=0
RETENTION_DEAD_LETTER_DAYS=0
RETENTION_AUDIT_DAYS=0
RETENTION_JOB_DAYS=0

# ─── 容量页（运维端）────────────────────────────────────────────────────────
# 自建库：保持默认（量备份卷所在的数据盘）。RDS：KCS_CAPACITY_DATA_PATH 置空，
# KCS_CAPACITY_DISK_BYTES 写 RDS 存储大小（字节，如 107374182400 = 100 GiB）
KCS_CAPACITY_DATA_PATH=/var/backups/kcs
KCS_CAPACITY_DISK_BYTES=

# ─── 对象存储（头像等图片；阿里云 OSS 私有桶）──────────────────────────────────
# 【选填】不填时图片字节存进 Postgres（小规模可用）。
# 桶的读写权限设「私有」；图片一律经 API /api/assets/raw/* 读出（S3_READ_MODE=proxy），
# 或 302 到 5 分钟有效的签名链接（S3_READ_MODE=redirect，省 ECS 流量）。
# 走 OSS 的 S3 兼容接口。ECS 与 OSS 同地域时用内网 endpoint（不收流量费）：
#   https://oss-cn-hongkong-internal.aliyuncs.com   （香港；大陆地域换成对应 Region ID）
# S3_REGION 填 OSS 的 Region ID 形式，如 oss-cn-hongkong（以 OSS「S3 兼容」文档为准，上线前用 README 的自检命令验一次）
S3_ENDPOINT=https://oss-cn-hongkong-internal.aliyuncs.com
S3_REGION=oss-cn-hongkong
S3_BUCKET=
# RAM 子账号 AccessKey，只授权这个桶（oss:PutObject / GetObject / ListObjects / DeleteObject）
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_READ_MODE=proxy

# ─── 备份 ───────────────────────────────────────────────────────────────────
# 每天 BACKUP_HOUR 点（TZ 时区）pg_dump 两个库（kcs + tinyship），存在卷 backups 里，
# 并上传到 BACKUP_S3_BUCKET/BACKUP_S3_PREFIX；本地与远端都只留 BACKUP_RETENTION_DAYS 天。
# 【强烈建议】单独一个私有桶（或同桶另一个前缀），并在 OSS 控制台给它加同样天数的生命周期规则兜底。
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
# 1 = backup 容器一启动先备份一次（首次上线建议开，验证完再关）
BACKUP_ON_START=0
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/
# 留空时沿用上面的 S3_*（同一把 RAM key 需要也能写备份桶）
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_FORCE_PATH_STYLE=

# ─── 邮件（选填：忘记密码邮件）────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_DEFAULT_FROM=

# ─── 资源上限（按 4 vCPU / 8 GiB 估；2 vCPU / 4 GiB 时各项减半）─────────────────
API_CPUS=1.5
API_MEMORY=1536m
WORKER_CPUS=1
WORKER_MEMORY=1024m
WEB_CPUS=0.5
WEB_MEMORY=512m
PG_CPUS=1.5
PG_MEMORY=2048m
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5
LOG_REQUESTS=1
