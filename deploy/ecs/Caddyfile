# 听潮边缘代理。拓扑由 KCS_TOPOLOGY 决定（见 caddy-sites/ 目录）：
#   hosts — 正式五主机名（多域名部署，MARKETING/SELECT/OPS/DEV/API_HOST 各不相同）
#   path  — 单机单 IP 按路径分流（四端共享同一 IP，SELECT_PATH 等提供路径前缀）
# 本文件只含两拓扑共用的全局块、安全头与上游片段；站点块在 caddy-sites/<拓扑>.caddy。
{
	email {$ACME_EMAIL}
	{$CADDY_EXTRA_GLOBAL}
}

(common) {
	# br for static files comes precompressed from Nitro (compressPublicAssets);
	# Caddy compresses the rest on the fly and never re-encodes an encoded body.
	encode zstd gzip
	header {
		Strict-Transport-Security "{$HSTS_VALUE}"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
}

# log 是站点级指令，不能出现在 handle 内；两个拓扑的站点块各自引入
(sitelog) {
	log {
		output stdout
		format json
	}
}

# The client IP is the TCP peer. X-Forwarded-For / X-Real-IP are *overwritten*,
# never appended: better-auth's sign-in throttle keys on X-Forwarded-For, so a
# client-supplied value must not survive. Behind Aliyun SLB / CDN, add
#   servers { trusted_proxies static <SLB/CDN ranges> }
# to the global block and use {client_ip} instead of {remote_host}.
(upstream) {
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

# A workspace app: everything — pages, /_nuxt assets, /__login, /__logout and its
# own better-auth routes under /api/auth/* — goes to that app, never to the API.
(app) {
	import common
	# `defer`: replace the app's own Cache-Control instead of sending two.
	@hashed path /_nuxt/*
	header @hashed {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}
	@icons path /favicon.ico /favicon-*.png /apple-touch-icon.png /android-chrome-*.png /logo.svg /site.webmanifest /robots.txt
	header @icons {
		Cache-Control "public, max-age=86400"
		defer
	}
	import upstream {args[0]}
}

import /etc/caddy/caddy-sites/{$KCS_TOPOLOGY:-hosts}.caddy
