# glibc 镜像：better-sqlite3 / pg 等原生依赖的预编译包在 musl 下不一定有，用 bookworm-slim 更稳。
FROM node:22-bookworm-slim AS builder

ARG APP
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json config.ts .npmrc ./
COPY config ./config
COPY packages ./packages
COPY libs ./libs
COPY apps ./apps

RUN test -n "$APP" \
  && pnpm install --filter "@kcs/app-${APP}..." --frozen-lockfile \
  && pnpm --filter "@kcs/app-${APP}" build

FROM node:22-bookworm-slim AS runner

ARG APP
ENV NODE_ENV=production
ENV NITRO_HOST=0.0.0.0
WORKDIR /app

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs --create-home nuxt \
  && mkdir -p /data && chown nuxt:nodejs /data

COPY --from=builder --chown=nuxt:nodejs /app/apps/${APP}/.output ./.output

USER nuxt
# 端口由 NITRO_PORT 决定（marketing 7000 / ops 7002 / dev 7003 / select 7004），默认 3000。
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
